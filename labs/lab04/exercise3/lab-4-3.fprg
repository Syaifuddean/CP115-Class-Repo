<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-3"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-14 10:11:16 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDswOTo1NToyOSBBTTsyNzUy"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDsxMDoxMToxNiBBTTsxOzI4NDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="hours" type="Integer" array="False" size=""/>
            <input variable="hours"/>
            <declare name="unitPrice" type="Integer" array="False" size=""/>
            <declare name="parkingFee" type="Integer" array="False" size=""/>
            <if expression="hours &lt;= 2">
                <then>
                    <assign variable="unitPrice" expression="0"/>
                    <assign variable="parkingFee" expression="0"/>
                </then>
                <else>
                    <if expression="hours &lt;= 5">
                        <then>
                            <assign variable="unitPrice" expression="2.00"/>
                            <assign variable="parkingFee" expression="(hours - 2) * 2.00"/>
                        </then>
                        <else>
                            <assign variable="unitPrice" expression="3.00"/>
                            <assign variable="parkingFee" expression="(hours - 2)* 3.00"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="unitPrice &lt;= 30">
                <then>
                    <output expression="parkingFee" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;You have maximum charge for this day&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
