<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-4"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-14 10:27:14 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDsxMDoxNzo0MSBBTTsyNzM2"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDsxMDoyNzoxNCBBTTsxOzI4NDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="weight" type="Integer" array="False" size=""/>
            <declare name="ticketPrice" type="Integer" array="False" size=""/>
            <input variable="weight"/>
            <input variable="ticketPrice"/>
            <declare name="charge" type="Integer" array="False" size=""/>
            <declare name="numOfBaggage" type="Integer" array="False" size=""/>
            <declare name="finalPrice" type="Integer" array="False" size=""/>
            <if expression="numOfBaggage &gt; 1">
                <then/>
                <else>
                    <assign variable="finalPrice" expression="ticketPrice - 10.00"/>
                </else>
            </if>
            <if expression="weight &lt;= 15">
                <then>
                    <assign variable="charge" expression="0"/>
                    <assign variable="finalPrice" expression="ticketPrice"/>
                </then>
                <else>
                    <assign variable="charge" expression="(weight - 15) * 4.00"/>
                    <assign variable="finalPrice" expression="ticketPrice + charge"/>
                </else>
            </if>
            <output expression="finalPrice" newline="True"/>
        </body>
    </function>
</flowgorithm>
