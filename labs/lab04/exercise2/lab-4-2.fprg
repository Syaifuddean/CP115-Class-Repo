<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-2"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-07 11:33:30 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNzsxMToyMzoxNiBBTTsyNzM4"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0wNzsxMTozMzozMCBBTTsxOzI4NDM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="income" type="Integer" array="False" size=""/>
            <input variable="income"/>
            <declare name="incomeTax" type="Integer" array="False" size=""/>
            <declare name="first" type="Integer" array="False" size=""/>
            <if expression="income &lt;= 50000">
                <then>
                    <if expression="first">
                        <then>
                            <assign variable="incomeTax" expression="0.00"/>
                        </then>
                        <else>
                            <assign variable="incomeTax" expression="0.01"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="incomeTax" expression="0.02"/>
                </else>
            </if>
            <declare name="totalTax" type="Integer" array="False" size=""/>
            <assign variable="totalTax" expression="income * incomeTax"/>
            <output expression="totalTax" newline="True"/>
        </body>
    </function>
</flowgorithm>
