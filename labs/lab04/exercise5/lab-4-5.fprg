<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-4-5"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-14 10:53:20 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDsxMDozMTozMCBBTTsyNzMw"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0xNDsxMDo1MzoyMCBBTTsxOzI4NDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="scoreA" type="Integer" array="False" size=""/>
            <declare name="scoreB" type="Integer" array="False" size=""/>
            <input variable="scoreA"/>
            <input variable="scoreB"/>
            <declare name="pointsA" type="Integer" array="False" size=""/>
            <declare name="pointsB" type="Integer" array="False" size=""/>
            <if expression="scoreA = scoreB">
                <then>
                    <assign variable="pointsA" expression="1"/>
                    <assign variable="pointsB" expression="1"/>
                </then>
                <else>
                    <if expression="scoreA &lt; scoreB">
                        <then>
                            <assign variable="pointsB" expression="3"/>
                            <assign variable="pointsA" expression="0"/>
                        </then>
                        <else>
                            <if expression="scoreA = 0">
                                <then>
                                    <assign variable="pointsB" expression="1"/>
                                </then>
                                <else>
                                    <if expression="scoreB = 0">
                                        <then>
                                            <assign variable="pointsA" expression="1"/>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                            <assign variable="pointsA" expression="3"/>
                            <assign variable="pointsB" expression="0"/>
                        </else>
                    </if>
                </else>
            </if>
            <declare name="finalPointsA" type="Integer" array="False" size=""/>
            <declare name="finalPointsB" type="Integer" array="False" size=""/>
            <assign variable="finalPointsA" expression="pointsA + pointsA + pointsA + pointsA"/>
            <assign variable="finalPointsB" expression="pointsB + pointsB + pointsB + pointsB"/>
            <output expression="finalPointsA" newline="True"/>
            <output expression="finalPointsB" newline="True"/>
        </body>
    </function>
</flowgorithm>
